# ─────────────────────────────────────────────────────────────
# SehatSaathi — copy to .env on the SERVER only. Never commit .env
# ─────────────────────────────────────────────────────────────

# --- Alibaba Cloud Model Studio (Singapore / International ONLY) ---
# Get a card-free key at https://home.qwencloud.com/benefits
# The free quota + Urdu support exist ONLY in the Singapore region.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WORKSPACE_ID is NOT needed: sk-ws- keys connect to the realtime socket
# directly, with no per-workspace subdomain. Verified by probing both forms.
REALTIME_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime

# Base endpoints (do not point these at cn-beijing — no Urdu, no free quota)
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_URL=https://dashscope-intl.aliyuncs.com/api/v1


# --- Model routing ---
MODEL_VOICE_REALTIME=qwen-audio-3.0-realtime-flash
MODEL_TRANSLATE_REALTIME=qwen3.5-livetranslate-flash-realtime
MODEL_BRAIN=qwen/qwen3.8-27b        # open-weight Qwen via Groq
MODEL_MEMORY=qwen/qwen3.8-27b
MODEL_ROUTER=qwen/qwen3.8-27b
# Used when Groq rate-limits. Must be a Model Studio id (no vendor prefix).
MODEL_FALLBACK=qwen-plus-character
MODEL_EMBED=qwen3.7-text-embedding
MODEL_TTS=qwen3-tts-instruct-flash

# Voice pipeline: A = omni end-to-end, B = livetranslate cascade,
# C = browser ur-PK + prerecorded clips. Set by the Hour-0 spike.
VOICE_PLAN=A
# Realtime voice. Verified: qwen-audio-3.0-realtime-flash returns fluent Urdu
# at ~950ms to first audio byte. Voices: longanqian longanlingxin longanlufeng
# longanlingxi longanxiaoxin longanfengyue longanyuanfei longanhuan_v3.6
# longjielidou_v3.6 longpaopao_v3.6 longhuohuo_v3.6 longchuanshu_v3.6
# loongmary loongeva_v3.6 loongjohn daniel echo hannah sherry
VOICE_NAME=sherry
MODEL_ASR=qwen3-asr-flash-2026-02-10

# --- Database ---
POSTGRES_USER=sehat
POSTGRES_PASSWORD=change_me_before_deploy
POSTGRES_DB=sehatsaathi
DATABASE_URL=postgres://sehat:change_me_before_deploy@db:5432/sehatsaathi

# --- Deployment ---
# The domain whose A record points at this server.
# TLS is terminated by the EXISTING host nginx + certbot (this stack does not
# bind 80/443 — they are already taken). See deploy/nginx-sehatsaathi.conf.
# WITHOUT HTTPS THE MICROPHONE WILL NOT WORK.
DOMAIN=sehat.example.com

# --- App ---
NODE_ENV=production
PORT=3000
# Emergency number surfaced in the escalation UI (Pakistan Rescue)
EMERGENCY_NUMBER=1122

# --- Urdu speech I/O (NOT Alibaba) ---
# Alibaba has no usable Urdu TTS: qwen-audio-3.0-realtime-flash writes correct
# Urdu but speaks it unintelligibly. Verified by listening, not by docs.
# Azure has purpose-built ur-PK neural voices; Groq Whisper handles Urdu ASR.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
AZURE_TTS_VOICE=ur-PK-UzmaNeural
# Azure has no en-PK voices; en-IN is the closest South Asian English.
AZURE_TTS_VOICE_EN=en-IN-NeerjaNeural
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# --- WhatsApp (Meta Cloud API) ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Free test number messages up to 5 verified recipients with no business review.
# Webhook: https://<DOMAIN>/api/whatsapp/webhook   subscribe to "messages"
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The human-readable number patients save, e.g. +92 300 1234567 (shown on the site)
WHATSAPP_DISPLAY_NUMBER=
# Caregiver number for the seeded demo patient (E.164, digits only is fine)
DEMO_CAREGIVER_PHONE=+923001234567
CLIPS_DIR=/app/data/clips
